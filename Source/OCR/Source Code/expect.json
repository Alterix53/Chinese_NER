{
    "FILE": {
        "ID": "HVNH_01",
        "meta": {
            "TITLE": "Khâm định Việt sử thông giám cương mục Quốc sử quán triều Nguyễn",
            "VOLUME": "01",
            "AUTHOR": "Phan Thanh Giản",
            "PERIOD": "Cận đại",
            "LANGUAGE": "Hán",
            "SOURCE": "Thư viện Quốc gia Việt Nam"
        },
        "SECT": {
            "ID": "HVNH_01.01",
            "NAME": "HVNH",
            "PAGES": [
                {
                    "ID": "001",
                    "STC": [
                        {
                            "ID": "HVNH_01.01.001.01",
                            "text": "欽定越史通鑑綱目卷首"
                        },
                        {
                            "ID": "HVNH_01.01.001.02",
                            "text": "e."
                        },
                        {
                            "ID": "HVNH_01.01.001.03",
                            "text": "嗣德八年十二月十五日奉"
                        },
                        {
                            "ID": "HVNH_01.01.001.04",
                            "text": "上融一代之興必有一代之史我越鴻而後陳黎"
                        },
                        {
                            "ID": "HVNH_01.01.001.05",
                            "text": "而前其门數千餘载政治之得失人物之督否疆"
                        },
                        {
                            "ID": "HVNH_01.01.001.06",
                            "text": "150"
                        },
                        {
                            "ID": "HVNH_01.01.001.07",
                            "text": "域之沿制度之興廢舊史所載猶多闕如至於"
                        },
                        {
                            "ID": "HVNH_01.01.001.08",
                            "text": "體裁之駁義例之疵亦不爲少學者考古不"
                        },
                        {
                            "ID": "HVNH_01.01.001.09",
                            "text": "無憾焉明命华周飲奉"
                        },
                        {
                            "ID": "HVNH_01.01.001.10",
                            "text": "聖準依醴部臣所請不遽以越史教學取士"
                        },
                        {
                            "ID": "HVNH_01.01.001.11",
                            "text": "重心蓋有待也通來國史之學未經者為功合故士之"
                        },
                        {
                            "ID": "HVNH_01.01.001.12",
                            "text": "讀書爲文帷知有北朝之史木國之史解或過面"
                        },
                        {
                            "ID": "HVNH_01.01.001.13",
                            "text": "間焉味於古者何以驗今籍談忘租伯魯將落正"
                        },
                        {
                            "ID": "HVNH_01.01.001.14",
                            "text": "今日學者之通病學術未明豈非舊史未備之故"
                        },
                        {
                            "ID": "HVNH_01.01.001.15",
                            "text": "欺今國家間暇學業大昌猴乙夜觀書篤志稽古"
                        },
                        {
                            "ID": "HVNH_01.01.001.16",
                            "text": "深惟越史未修古學未亦是熙朝一缺是以"
                        }
                    ]
                },
                {
                    "ID": "002",
                    "STC": [
                        {
                            "ID": "HVNH_01.01.002.01",
                            "text": "經筵臨幸召對儒臣商論經史末营不及於此修"
                        },
                        {
                            "ID": "HVNH_01.01.002.02",
                            "text": "史一事志先定大典允宜以辰舉行著以開年"
                        },
                        {
                            "ID": "HVNH_01.01.002.03",
                            "text": "交廷臣避舉監修越史官正副總裁各一纂修人"
                        },
                        {
                            "ID": "HVNH_01.01.002.04",
                            "text": "員考校六員膽寫八名將歷代史編年一書參以"
                        },
                        {
                            "ID": "HVNH_01.01.002.05",
                            "text": "諸家稗乘記載之言搜採遺軼訂正訛筆削褒"
                        },
                        {
                            "ID": "HVNH_01.01.002.06",
                            "text": "贬一準紫陽目書法夏輯編定勒成欽定越史"
                        },
                        {
                            "ID": "HVNH_01.01.002.07",
                            "text": "通鑑綱目全部且修史太平之鉅典漢於東觀米"
                        },
                        {
                            "ID": "HVNH_01.01.002.08",
                            "text": "於票文重其事也其此次史局應于何處開設"
                        },
                        {
                            "ID": "HVNH_01.01.002.09",
                            "text": "切合行諸事宜著由醴部酌提具奏侯旨用昭"
                        },
                        {
                            "ID": "HVNH_01.01.002.10",
                            "text": "盛典此"
                        },
                        {
                            "ID": "HVNH_01.01.002.11",
                            "text": "嗣德九年六月初十日奉充越史局裁副總"
                        },
                        {
                            "ID": "HVNH_01.01.002.12",
                            "text": "裁算金修等謹"
                        },
                        {
                            "ID": "HVNH_01.01.002.13",
                            "text": "奏為将欽修越史所有統侧謹奉會同查考提請"
                        },
                        {
                            "ID": "HVNH_01.01.002.14",
                            "text": "候"
                        }
                    ]
                },
                {
                    "ID": "003",
                    "STC": [
                        {
                            "ID": "HVNH_01.01.003.01",
                            "text": "旨事炫饮奉"
                        },
                        {
                            "ID": "HVNH_01.01.003.02",
                            "text": "准等將我越歷代史編年一書參以諸家稗乘"
                        },
                        {
                            "ID": "HVNH_01.01.003.03",
                            "text": "記載之言搜採遺軼訂正訛謬筆削褒貶一准"
                        },
                        {
                            "ID": "HVNH_01.01.003.04",
                            "text": "紫陽網目書法复輯編定勒成欽定越史通鑑"
                        },
                        {
                            "ID": "HVNH_01.01.003.05",
                            "text": "日全部各等因等竊以修史之事莫大於"
                        },
                        {
                            "ID": "HVNH_01.01.003.06",
                            "text": "明正统奉查之綱目朱子所自親定起周威烈"
                        },
                        {
                            "ID": "HVNH_01.01.003.07",
                            "text": "王戊寅二十三年至五代後周泰帝己未元年"
                        },
                        {
                            "ID": "HVNH_01.01.003.08",
                            "text": "三"
                        },
                        {
                            "ID": "HVNH_01.01.003.09",
                            "text": "上謂之正編至於前編續編均遵朱子書法前"
                        },
                        {
                            "ID": "HVNH_01.01.003.10",
                            "text": "編元儒金履解則以尚書為據而斷自唐堯以"
                        },
                        {
                            "ID": "HVNH_01.01.003.11",
                            "text": "下接於通鑑之前明儒渭上南軒又湖自危羲"
                        },
                        {
                            "ID": "HVNH_01.01.003.12",
                            "text": "氏以爲危義萬世文字之祖帝王治平之源則"
                        },
                        {
                            "ID": "HVNH_01.01.003.13",
                            "text": "作史者富自伏義造端無疑也若夫盤古三皇"
                        },
                        {
                            "ID": "HVNH_01.01.003.14",
                            "text": "之世载籍無稽故闕之也奉查之舊更鴻尼"
                        },
                        {
                            "ID": "HVNH_01.01.003.15",
                            "text": "民紀涇陽王貉龍君之稱緣上古世屬渺港作"
                        }
                    ]
                }
            ]
        }
    }
}